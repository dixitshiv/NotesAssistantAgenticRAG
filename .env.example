# Copy this file to .env and fill in the values.
#   cp .env.example .env

# REQUIRED — absolute path to a folder of .md files (subfolders are scanned too)
NOTES_DIR=/absolute/path/to/your/markdown/folder

# OPTIONAL — override the conversation thread for testing
# THREAD_ID=test-foo

# OPTIONAL — LangSmith tracing (free tier at https://smith.langchain.com)
# Without these, the agent runs fine but you won't see traces in the UI.
# LANGSMITH_API_KEY=lsv2_pt_...your-key...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=PersonalRAG
